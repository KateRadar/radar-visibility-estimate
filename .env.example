# Copy to `.env.local` for local dev. Set real values in the Vercel project dashboard — never commit secrets.

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
KLAVIYO_PRIVATE_KEY=pk_REPLACE_ME
KLAVIYO_LIST_ID=REPLACE_ME

# Admin dashboard (/admin) — session signing
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_16_CHARS

# Initial admin login password (plaintext). After you set Upstash Redis, use the dashboard to set a bcrypt hash in Redis and you can rotate away from env if you prefer.
ADMIN_PASSWORD=REPLACE_ME

# Upstash Redis — stores form submissions + optional bcrypt password hash (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
